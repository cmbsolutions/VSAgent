<Page x:Class="AppearanceSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VSAgent.Extension"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AppearanceSettingsPage">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    
    <StackPanel>

        <TextBlock Text="Appearance"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#F2F5FA"/>

        <TextBlock Text="Customize the VSAgent interface."
                   Style="{StaticResource MutedText}"
                   Margin="0,6,0,25"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Show thinking"
                           Style="{StaticResource SectionTitle}"/>

                <TextBlock Text="Display model reasoning in the conversation"
                           Style="{StaticResource MutedText}"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <CheckBox Grid.Column="1"
                      Style="{StaticResource ToggleSwitch}"
                      VerticalAlignment="Center"
                      IsChecked="{Binding ShowThinking, Mode=TwoWay,
                                          UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

    </StackPanel>
</Page>
