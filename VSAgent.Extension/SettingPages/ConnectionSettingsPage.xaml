<Page x:Class="ConnectionSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VSAgent.Extension"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ConnectionSettingsPage">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <StackPanel>

        <TextBlock Text="Connection"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#F2F5FA"/>

        <TextBlock Text="Configure the inference provider connection."
                   Style="{StaticResource MutedText}"
                   Margin="0,6,0,25"/>

        <TextBlock Text="Provider API URL"
                   Style="{StaticResource SectionTitle}"
                   Margin="0,0,0,9"/>

        <TextBox Height="36"
                 Padding="10,7"
                 Background="{StaticResource InputBrush}"
                 Foreground="#E9EDF3"
                 BorderBrush="{StaticResource BorderBrush}"
                 BorderThickness="1"
                 VerticalContentAlignment="Center"
                 Text="{Binding InferenceProviderBaseURL,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Base URL of the selected inference provider."
                   Style="{StaticResource MutedText}"
                   Margin="0,7,0,0"/>

        <Border Style="{StaticResource DividerStyle}"/>

        <TextBlock Text="Connection status"
                   Style="{StaticResource SectionTitle}"
                   Margin="0,0,0,9"/>

        <TextBlock Text="Connection testing will be available after provider integration."
                   Style="{StaticResource MutedText}"
                   TextWrapping="Wrap"/>

    </StackPanel>
</Page>
