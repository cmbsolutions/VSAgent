<Window x:Class="SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VSAgent Settings"
        Width="570" Height="729"
        MinWidth="530" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#15191F"
        Foreground="#E9EDF3"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False" Icon="vsagent.ico" Topmost="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingPages/SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="15"
            Padding="24">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="⚙  VSAgent Settings"
                           FontSize="19"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Model and inference configuration"
                           Style="{StaticResource MutedText}"
                           Margin="0,6,0,0"/>
                <Border Style="{StaticResource DividerStyle}"/>
            </StackPanel>

            <!-- Settings -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="155"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="lstSettingsPages"
             Grid.Column="0"
             Background="{StaticResource InputBrush}"
             Foreground="#E9EDF3"
             BorderThickness="0"
             SelectionChanged="lstSettingsPages_SelectionChanged">

                    <ListBoxItem Content="Models" Tag="Models"/>
                    <ListBoxItem Content="Inference" Tag="Inference"/>
                    <ListBoxItem Content="Agent" Tag="Agent"/>
                    <ListBoxItem Content="Appearance" Tag="Appearance"/>
                    <ListBoxItem Content="Connection" Tag="Connection"/>

                </ListBox>

                <Border Grid.Column="1"
            Padding="20,5,0,5">

                    <Frame x:Name="settingsFrame"
       NavigationUIVisibility="Hidden"
       Background="Transparent"
       JournalOwnership="OwnsJournal"/>

                </Border>
            </Grid>

            <!-- Footer -->
            <StackPanel Grid.Row="2">
                <Border Style="{StaticResource DividerStyle}"
                        Margin="0,12,0,14"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="Reset to defaults"
                            Style="{StaticResource ActionButton}"
                            HorizontalAlignment="Left"
                            Click="Reset_Click"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button Content="Cancel"
                                Style="{StaticResource ActionButton}"
                                Margin="0,0,8,0"
                                Click="Cancel_Click"/>
                        <Button Content="Save settings"
                                Style="{StaticResource PrimaryButton}"
                                Click="Save_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

        </Grid>
    </Border>
</Window>
