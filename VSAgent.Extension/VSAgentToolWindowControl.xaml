<UserControl x:Class="VSAgentToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             Name="MyToolWindow">
    <Grid Margin="8">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <RichTextBox x:Name="txtOutput"
             IsReadOnly="True"
             VerticalScrollBarVisibility="Auto"
             BorderThickness="0">
            <FlowDocument PagePadding="0" />
        </RichTextBox>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label x:Name="lblStats" Content="Enter a message below and hit send." Grid.Column="0" Foreground="#FFA2A1A1" Padding="5,0,5,0" HorizontalContentAlignment="Stretch"/>
        </Grid>

        <Grid Grid.Row="2"
              Margin="0,8,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtPrompt"
                     Grid.Column="0"
                     Margin="0,0,8,0" AutomationProperties.HelpText="Type /exit or /quit to stop." ToolTip="Type /exit or /quit to stop." Cursor="IBeam" />

            <Button x:Name="btnSend"
                    Grid.Column="1"
                    Content="Send"
                    Padding="14,5"
                    Margin="0,0,8,0" IsEnabled="False" />

            <Button x:Name="btnStop"
                    Grid.Column="2"
                    Content="Stop"
                    Padding="14,5" />

        </Grid>


    </Grid>
</UserControl>
