<UserControl x:Class="VSAgentToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
             mc:Ignorable="d" d:DesignHeight="300"  d:DesignWidth="300"
             Name="MyToolWindow">
    
    <UserControl.Resources>

        <SolidColorBrush x:Key="PanelBrush" Color="#1E242D"/>
        <SolidColorBrush x:Key="InputBrush" Color="#252D38"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#394352"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9BA7B6"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#638CF5"/>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F2F5FA"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="DividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#35404D"/>
            <Setter Property="Margin" Value="0,18,0,18"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="#E9EDF3"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button"
               BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ReasoningButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#ADB8C7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Outer"
                                Background="Transparent"
                                CornerRadius="6"
                                Margin="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="Background"
                                        Value="#435A89"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Opacity"
                                        Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSlider" TargetType="Slider">
            <Setter Property="Height" Value="25"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="24">
                            <Border Height="6" CornerRadius="3"
                                    Background="#374353"
                                    VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6"
                                                        Background="#638CF5"
                                                        CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#DCE7FF"
                                                         Stroke="#638CF5"
                                                         StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="43" Height="24">
                            <Border x:Name="SwitchTrack"
                                    Background="#4A5565"
                                    CornerRadius="12"/>
                            <Ellipse x:Name="SwitchThumb"
                                     Width="18" Height="18"
                                     Fill="White"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack"
                                        Property="Background"
                                        Value="#638CF5"/>
                                <Setter TargetName="SwitchThumb"
                                        Property="HorizontalAlignment"
                                        Value="Right"/>
                                <Setter TargetName="SwitchThumb"
                                        Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#252D38"/>
            <Setter Property="Foreground" Value="#E9EDF3"/>
            <Setter Property="BorderBrush" Value="#465367"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

    </UserControl.Resources>

    <Grid x:Name="ThisGrid" Margin="8">

        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button x:Name="btnSettings" Content="⚙"
        Style="{StaticResource ActionButton}"
        HorizontalAlignment="Right"
        Click="Settings_Click" Grid.Row="0"/>
        
        <!--<Expander Grid.Row="0" x:Name="expSettings" Height="100" Header="" Foreground="#FFFDFDFD" VerticalAlignment="Top">
            <Grid Background="#FF272727">
                <Grid.RowDefinitions>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="chkThinking" Content="Show Thinking process" IsChecked="True" Grid.ColumnSpan="2" Foreground="White"/>
                <ComboBox x:Name="cmbModels" Margin="50,5,-115,0" Grid.Row="1" VerticalAlignment="Top"/>
                <Label Content="Model:" HorizontalAlignment="Left" Margin="4,3,0,0" Grid.Row="1" VerticalAlignment="Top" Foreground="White"/>
            </Grid>
        </Expander>-->

        <RichTextBox Grid.Row="1" x:Name="txtOutput"
             IsReadOnly="True"
             VerticalScrollBarVisibility="Auto"
             BorderThickness="1,1,1,1" IsUndoEnabled="False" AllowDrop="False" Cursor="IBeam" BorderBrush="#FF3462EF" Foreground="#FFE8E8E8">
            <RichTextBox.Background>
                <LinearGradientBrush EndPoint="1,1" StartPoint="0,0" SpreadMethod="Pad" MappingMode="RelativeToBoundingBox">
                    <GradientStop Color="#FF232323" Offset="0"/>
                    <GradientStop Color="#FF2D2D2D" Offset="1"/>
                </LinearGradientBrush>
            </RichTextBox.Background>
            <FlowDocument PagePadding="0"
                          TextElement.FontSize="12">
                <FlowDocument.Resources>
                    <Style TargetType="{x:Type Paragraph}">
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </FlowDocument.Resources>
            </FlowDocument>
        </RichTextBox>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label x:Name="lblStats" Content="Enter a message below and hit send." Grid.Column="0" Foreground="#FFA2A1A1" Padding="5,0,5,0" HorizontalContentAlignment="Stretch"/>
        </Grid>

        <Grid Grid.Row="3"
              Margin="0,8,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtPrompt"
                     Grid.Column="0"
                     Margin="0,0,8,0" AutomationProperties.HelpText="Type /exit or /quit to stop." ToolTip="Type /exit or /quit to stop." Cursor="IBeam" BorderBrush="#FF3462EF" Foreground="#FFE8E8E8" CaretBrush="#FFE6E6E6" >
                <TextBox.Background>
                    <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                        <GradientStop Color="#FF232323"/>
                        <GradientStop Color="#FF2D2D2D" Offset="1"/>
                    </LinearGradientBrush>
                </TextBox.Background>
            </TextBox>

            <Button x:Name="btnSend"
                    Style="{StaticResource ActionButton}"
                    Grid.Column="1"
                    Content="Send"
                    Padding="14,0"
                    Margin="0,0,8,0" IsEnabled="False" Background="#FF2D2D2D" Foreground="#FFE8E8E8" />

            <Button x:Name="btnStop"
                    Style="{StaticResource ActionButton}"
                    Grid.Column="2"
                    Content="Stop"
                    Padding="14,0" IsEnabled="False" Background="#FF2D2D2D" Foreground="#FFE8E8E8" />

        </Grid>
    </Grid>
</UserControl>
